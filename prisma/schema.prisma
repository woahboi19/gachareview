// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?   // New bio field
  spoilerMode   Boolean   @default(true) // Global spoiler toggle
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  upvotes       Upvote[]
  favorites     FavoriteGame[]
  gameStatuses  UserGameStatus[] // New GameStatus relation
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Game {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  imageUrl      String?
  developer     String
  isEditorsPick Boolean  @default(false)
  averageScore  Float    @default(0.0)
  genres        Genre[]
  chapters      StoryChapter[]
  reviews       Review[]
  favoritedBy   FavoriteGame[]
  userStatuses  UserGameStatus[]
  characters    Character[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  games     Game[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoryChapter {
  id          String   @id @default(cuid())
  gameId      String
  slug        String
  title       String
  chapterNum  Int
  summary     String
  imageUrl    String?  // Optional image for the chapter
  category    String   @default("Main Story")
  chapterType String   @default("MAIN") // MAIN, EXTRA, EVENT, CHARACTER
  chapterCode String?  // e.g. "S1.E1", "EX-02"
  isMain      Boolean  @default(false)
  releaseDate DateTime?
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reviews     Review[]
  characters  Character[] // Featured characters in this chapter
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([gameId, slug])
  @@index([gameId])
}

model Review {
  id          String   @id @default(cuid())
  rating      Float    // 0.5 to 5.0
  content     String
  isSpoiler   Boolean  @default(false)
  userId      String
  gameId      String?
  chapterId   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  chapter     StoryChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  upvotes     Upvote[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([gameId])
  @@index([chapterId])
  @@index([userId])
}

model Upvote {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@index([userId])
}

model FavoriteGame {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

enum GameStatus {
  PLAYING
  DROPPED
  COMPLETED
  FAVORITE
}

model UserGameStatus {
  id        String     @id @default(cuid())
  userId    String
  gameId    String
  status    GameStatus
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

model Character {
  id          String   @id @default(cuid())
  gameId      String
  name        String
  lore        String
  imageUrl    String?
  voiceActorEN String?
  voiceActorJP String?
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  chapters    StoryChapter[] // Chapters this character appears in
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([gameId])
}
